credit_risk_monitoring:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: dev.duckdb            # relative, not an absolute /Users/... path
      threads: 4
    prod:
      type: bigquery
      method: oauth
      project: your-gcp-project   # cloner sets their own
      dataset: dbt_credit_scoring
      location: asia-southeast1
      threads: 4